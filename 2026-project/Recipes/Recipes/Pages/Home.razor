@page "/"

<PageTitle>Home</PageTitle>

<h1>Recipe manager</h1>

<p class="lead">Create recipes, organize ingredients, and manage categories.</p>

<div class="row g-3 mt-2">
    <div class="col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none" href="recipes">
            <div class="card-body">
                <h2 class="h5">Recipes</h2>
                <p class="text-secondary mb-0">Create and edit recipes with ingredient lists.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none" href="categories">
            <div class="card-body">
                <h2 class="h5">Categories</h2>
                <p class="text-secondary mb-0">Organize recipes into categories.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none" href="ingredients">
            <div class="card-body">
                <h2 class="h5">Ingredients</h2>
                <p class="text-secondary mb-0">Maintain the ingredient catalogue.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none" href="recipe-ingredients">
            <div class="card-body">
                <h2 class="h5">Recipe ingredients</h2>
                <p class="text-secondary mb-0">Adjust ingredient quantities and units.</p>
            </div>
        </a>
    </div>
</div>
