@page "/recipes"
@inject RecipeApiClient Api
@inject IJSRuntime JS

<PageTitle>Recipes</PageTitle>

<div class="mb-4">
    <h1>Recipes</h1>
    <p class="text-secondary mb-0">Create and maintain recipes and their ingredient lists.</p>
</div>

<ApiFeedback Error="@(gridError ?? error)" Success="@success" />

@if (categories is null || ingredients is null)
{
    <p>Loading recipes...</p>
}
else
{
    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h4">@(selected is null ? "Add a recipe" : $"Edit: {selected.Name}")</h2>
            @if (categories.Count == 0 || ingredients.Count == 0)
            {
                <p class="text-secondary">Add at least one category and one ingredient before creating a recipe.</p>
            }
            else
            {
                <RecipeForm @key="(selected?.Id, formVersion)" Categories="categories" Ingredients="ingredients"
                            InitialValue="selected" OnSave="SaveAsync" OnCancel="CancelEdit" />
            }
        </div>
    </section>

    <h2 class="h4">All recipes</h2>
    @if (gridFailed)
    {
        <button class="btn btn-outline-primary mb-3" @onclick="RefreshGridAsync">Retry loading recipes</button>
    }
    @if (gridLoaded && !gridFailed && gridEmpty)
    {
        <p class="text-secondary">No recipes yet.</p>
    }
    <div class="table-responsive">
        <QuickGrid TGridItem="RecipeGridRow" @ref="grid" ItemsProvider="recipeProvider" Pagination="pagination" Class="table table-striped align-middle" ItemKey="@(row => row.Recipe.Id)">
            <TemplateColumn Title="Recipe" SortBy="recipeNameSort" Sortable="true" Context="row">
                <strong>@row.Recipe.Name</strong>
                @if (!string.IsNullOrWhiteSpace(row.Recipe.Description))
                {
                    <div class="small text-secondary">@row.Recipe.Description</div>
                }
            </TemplateColumn>
            <PropertyColumn Title="Category" Property="@(row => row.Category)" Sortable="true" />
            <PropertyColumn Title="Ingredients" Property="@(row => row.Ingredients)" Sortable="true" />
            <TemplateColumn Title="Time" SortBy="preparationTimeSort" Sortable="true" Context="row">
                @row.Recipe.PreparationMinutes min
            </TemplateColumn>
            <PropertyColumn Title="Servings" Property="@(row => row.Recipe.Servings)" Sortable="true" />
            <TemplateColumn Title="Actions" Class="text-end text-nowrap" Context="row">
                <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(row.Recipe)">Edit</button>
                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAsync(row.Recipe)">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <Paginator State="pagination" />
}
