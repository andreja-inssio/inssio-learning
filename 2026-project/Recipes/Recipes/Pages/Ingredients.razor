@page "/ingredients"
@inject RecipeApiClient Api
@inject IJSRuntime JS

<PageTitle>Ingredients</PageTitle>

<div class="mb-4">
    <h1>Ingredients</h1>
    <p class="text-secondary mb-0">Manage the ingredients used in recipes.</p>
</div>

<section id="ingredient-usage" class="mt-4">
    <h2 class="h4">Ingredient usage</h2>
    <p>GroupJoin with SelectMany and DefaultIfEmpty keeps unused ingredients in the results.</p>
    <ApiFeedback Error="@usageError" />
    @if (usageError is not null)
    {
        <button class="btn btn-outline-primary" @onclick="LoadUsageAsync">Retry loading usage</button>
    }
    else if (usage is null)
    {
        <p role="status">Loading ingredient usage...</p>
    }
    else
    {
        <label class="form-check mb-3">
            <input type="checkbox" class="form-check-input" @bind="unusedOnly" />
            <span class="form-check-label">Show unused ingredients only</span>
        </label>
        @if (!usage.Any(item => !unusedOnly || item.RecipeId is null))
        {
            <p>@(unusedOnly ? "No unused ingredients." : "No ingredients yet.")</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead><tr><th scope="col">Ingredient</th><th scope="col">Recipe</th></tr></thead>
                    <tbody>
                        @foreach (var item in usage.Where(item => !unusedOnly || item.RecipeId is null))
                        {
                            <tr>
                                <td>@item.IngredientName</td>
                                <td>
                                    @if (item.RecipeId is not null)
                                    {
                                        <a href="@($"/recipes/{item.RecipeId}/history")">@item.RecipeName</a>
                                    }
                                    else
                                    {
                                        <span>Unused</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

<ApiFeedback Error="@error" Success="@success" />

<div class="row g-4">
    <section class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h4">@(selected is null ? "Add an ingredient" : "Edit ingredient")</h2>
                <NameForm @key="selected?.Id" EntityName="ingredient"
                          InitialValue="@(selected is null ? null : new NameFormModel { Name = selected.Name ?? "" })"
                          OnSave="SaveAsync" OnCancel="CancelEdit" />
            </div>
        </div>
    </section>
    <section class="col-lg-7">
        <h2 class="h4">All ingredients</h2>
        @if (ingredients is null)
        {
            <p>Loading ingredients...</p>
        }
        else if (ingredients.Count == 0)
        {
            <p class="text-secondary">No ingredients yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead><tr><th>Name</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var ingredient in ingredients)
                        {
                            <tr>
                                <td>@ingredient.Name</td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(ingredient)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteAsync(ingredient)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
